#include <stdio.h>
#include <stdlib.h>

static int milla_idx(int i, int n) { if (i < 0 || i >= n) { fprintf(stderr, "erro: indice %d fora dos limites [0, %d)\n", i, n); exit(1); } return i; }

int main(void) {
    int T1[5]; /* quadrados : vetor[int] */
    int T2;
    int T3; /* i : inferida int */
    int T4;
    int T5;
    int T6;
    int T7;
    int T8;
    int T9;
    int T10;
    int T11;
    int T12;
    int T13;
    int T14;
    int T15;
    int T16;

    T2 = 0;
    T3 = T2;
    L1: ;
    T4 = 5;
    T5 = T3 < T4;
    if (!T5) goto L3;
    T9 = T3 * T3;
    T1[milla_idx(T3, 5)] = T9;
    T6 = T3;
    T7 = 1;
    T8 = T6 + T7;
    T3 = T8;
    goto L1;
    L3: ;
    T10 = 0;
    T3 = T10;
    L4: ;
    T11 = 5;
    T12 = T3 < T11;
    if (!T12) goto L6;
    T16 = T1[milla_idx(T3, 5)];
    printf("%d\n", T16);
    T13 = T3;
    T14 = 1;
    T15 = T13 + T14;
    T3 = T15;
    goto L4;
    L6: ;
    return 0;
}
