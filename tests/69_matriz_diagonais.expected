#include <stdio.h>
#include <stdlib.h>
#include <string.h>

static int milla_idx(int i, int n) { if (i < 0 || i >= n) { fprintf(stderr, "erro: indice %d fora dos limites [0, %d)\n", i, n); exit(1); } return i; }

static char* milla_strcat(const char* a, const char* b) { char* r = (char*) malloc(strlen(a) + strlen(b) + 1); strcpy(r, a); strcat(r, b); return r; }
static char* milla_int_str(int v) { char* r = (char*) malloc(16); snprintf(r, 16, "%d", v); return r; }

int main(void) {
    int T1;
    int T2;
    int T3;
    int T4;
    int T5;
    int T6;
    int T7;
    int T8;
    int T9;
    int T10[3][3]; /* m : vetor[int] */
    int T11;
    int T12; /* principal */
    int T13;
    int T14; /* i : inferida int */
    int T15;
    int T16;
    int T17;
    int T18;
    int T19;
    int T20;
    int T21;
    int T22; /* secundaria */
    int T23;
    int T24;
    int T25;
    int T26;
    int T27;
    int T28;
    int T29;
    int T30;
    int T31;
    char* T32 = NULL;
    char* T33 = NULL;
    char* T34 = NULL;
    char* T35 = NULL;

    T1 = 1;
    T10[0][0] = T1;
    T2 = 2;
    T10[0][1] = T2;
    T3 = 3;
    T10[0][2] = T3;
    T4 = 4;
    T10[1][0] = T4;
    T5 = 5;
    T10[1][1] = T5;
    T6 = 6;
    T10[1][2] = T6;
    T7 = 7;
    T10[2][0] = T7;
    T8 = 8;
    T10[2][1] = T8;
    T9 = 9;
    T10[2][2] = T9;
    T11 = 0;
    T12 = T11;
    T13 = 0;
    T14 = T13;
    L1: ;
    T15 = 3;
    T16 = T14 < T15;
    if (!T16) goto L3;
    T19 = T10[milla_idx(T14, 3)][milla_idx(T14, 3)];
    T20 = T12 + T19;
    T12 = T20;
    T17 = 1;
    T18 = T14 + T17;
    T14 = T18;
    goto L1;
    L3: ;
    T21 = 0;
    T22 = T21;
    T23 = 0;
    T14 = T23;
    L4: ;
    T24 = 3;
    T25 = T14 < T24;
    if (!T25) goto L6;
    T28 = 2;
    T29 = T28 - T14;
    T30 = T10[milla_idx(T14, 3)][milla_idx(T29, 3)];
    T31 = T22 + T30;
    T22 = T31;
    T26 = 1;
    T27 = T14 + T26;
    T14 = T27;
    goto L4;
    L6: ;
    T32 = milla_int_str(T12);
    T33 = milla_strcat("diagonal principal: ", T32);
    free(T32);
    printf("%s\n", T33);
    free(T33);
    T34 = milla_int_str(T22);
    T35 = milla_strcat("diagonal secundaria: ", T34);
    free(T34);
    printf("%s\n", T35);
    free(T35);
    return 0;
}
