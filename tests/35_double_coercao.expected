#include <stdio.h>

int main(void) {
    int T1; /* I */
    float T2; /* F */
    double T3; /* D */
    int T4;
    float T5;
    float T6;
    float T7;
    double T8;

    T4 = 2;
    T1 = T4;
    T5 = 3.0;
    T2 = T5;
    T6 = (float) T1;
    T7 = T6 + T2;
    T8 = (double) T7;
    T3 = T8;
    return 0;
}
