#include <stdio.h>

int main(void) {
    int T1; /* I */
    float T2; /* F */
    double T3; /* D */
    int T4;
    double T5;
    float T6;
    float T7;
    float T8;
    double T9;

    T4 = 2;
    T1 = T4;
    T5 = 3.0;
    T6 = (float) T5;
    T2 = T6;
    T7 = (float) T1;
    T8 = T7 + T2;
    T9 = (double) T8;
    T3 = T9;
    return 0;
}
