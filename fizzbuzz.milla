for i = 1; i <= 20; i = i + 1 {
    int chave = 0;
    if i % 15 == 0 {
        chave = 3;
    } else if i % 3 == 0 {
        chave = 1;
    } else if i % 5 == 0 {
        chave = 2;
    }

    match chave {
        1 -> { mout("Fizz"); },
        2 -> { mout("Buzz"); },
        3 -> { mout("FizzBuzz"); },
        _ -> { mout("#{i}"); }
    }
}
